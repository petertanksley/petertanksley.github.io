<ul class="newslist">
<% for (const item of items) { const blurb = item.description ? String(item.description).trim().replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>') : ""; %>
<li<% if (item.id) { %> id="<%= item.id %>"<% } %>>
<span class="when"><%= item.date %></span>
<span>
<span class="news-title"><%= item.title %></span>
<% if (blurb) { %><span class="blurb"><%= blurb %></span><% } %><% if (item.image) { %><img class="news-photo" src="<%= item.image %>" alt="<%- item['image-alt'] || '' %>" loading="lazy"><% } %>
</span>
</li>
<% } %>
</ul>
